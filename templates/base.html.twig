<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Pricing{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <style>
            :root {
                --bg: #f5f5f5;
                --surface: #ffffff;
                --text: #1a1a1a;
                --muted: #555555;
                --border: #d0d0d0;
                --accent: #1f4b99;
                --accent-hover: #163a78;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Georgia, "Times New Roman", serif;
                background: var(--bg);
                color: var(--text);
                line-height: 1.5;
            }

            .container {
                max-width: 960px;
                margin: 0 auto;
                padding: 1.5rem;
            }

            nav {
                display: flex;
                gap: 1rem;
                margin-bottom: 1.5rem;
                padding-bottom: 0.75rem;
                border-bottom: 1px solid var(--border);
            }

            nav a {
                color: var(--accent);
                text-decoration: none;
                font-weight: 600;
            }

            nav a:hover {
                color: var(--accent-hover);
                text-decoration: underline;
            }

            h1, h2 {
                margin-top: 0;
            }

            form {
                background: var(--surface);
                border: 1px solid var(--border);
                padding: 1.25rem;
                margin-bottom: 1.5rem;
            }

            form > div,
            .form-row {
                margin-bottom: 0.85rem;
            }

            label {
                display: block;
                margin-bottom: 0.25rem;
                font-weight: 600;
            }

            input[type="text"],
            input[type="number"],
            input[type="date"],
            select,
            textarea {
                width: 100%;
                max-width: 28rem;
                padding: 0.45rem 0.55rem;
                border: 1px solid var(--border);
                background: #fff;
                font: inherit;
            }

            input.is-invalid,
            .has-error input,
            .has-error select,
            input[aria-invalid="true"] {
                border-color: #9b1c1c;
                background: #fff5f5;
            }

            button,
            input[type="submit"] {
                margin-top: 0.5rem;
                padding: 0.55rem 1rem;
                border: 0;
                background: var(--accent);
                color: #fff;
                font: inherit;
                cursor: pointer;
            }

            button:hover,
            input[type="submit"]:hover {
                background: var(--accent-hover);
            }

            table {
                width: 100%;
                border-collapse: collapse;
                background: var(--surface);
                margin-bottom: 1rem;
            }

            th,
            td {
                border: 1px solid var(--border);
                padding: 0.6rem 0.75rem;
                text-align: left;
                vertical-align: top;
            }

            th {
                background: #ebebeb;
            }

            ul {
                margin: 0.25rem 0;
                padding-left: 1.2rem;
            }

            .form-help {
                display: block;
                margin-top: 0.2rem;
                color: var(--muted);
                font-size: 0.9rem;
            }

            .form-error-banner {
                margin-bottom: 1rem;
                padding: 0.75rem 1rem;
                border: 1px solid #9b1c1c;
                background: #fff5f5;
                color: #9b1c1c;
            }

            .form-error-banner[hidden] {
                display: none;
            }

            .form-errors {
                margin: 0.35rem 0 0.5rem;
                padding-left: 1.1rem;
                list-style: disc;
            }

            .error,
            .form-error,
            ul.form-errors .form-error,
            ul li .form-error {
                color: #9b1c1c;
                font-weight: 600;
            }

            .has-error label {
                color: #9b1c1c;
            }
        </style>
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
